{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "start": "python bot/main.py",
  "services": [
    { "name": "postgres", "type": "postgres" },
    { "name": "redis", "type": "redis" }
  ],
  "deploy": {
    "startCommand": "gunicorn -k uvicorn.workers.UvicornWorker bot.web:app & python bot/main.py"
  }
}
