{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "python -m bot.main",
    "restartPolicy": { "type": "on-failure", "maxRetries": 10 }
  },
  "services": [
    { "name": "Postgres", "type": "postgres" },
    { "name": "Redis", "type": "redis" }
  ]
}
